{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "VansFunctions", "Effect": "Allow", "Action": "lambda:*",
      "Resource": "arn:aws:lambda:ap-south-1:866923470948:function:vans-*" },
    { "Sid": "SeeFunctions", "Effect": "Allow",
      "Action": ["lambda:ListFunctions", "lambda:GetAccountSettings"], "Resource": "*" },
    { "Sid": "VansRole", "Effect": "Allow",
      "Action": ["iam:CreateRole", "iam:GetRole", "iam:DeleteRole", "iam:ListAttachedRolePolicies", "iam:DetachRolePolicy"],
      "Resource": "arn:aws:iam::866923470948:role/vans-*" },
    { "Sid": "RoleMayOnlyLog", "Effect": "Allow", "Action": "iam:AttachRolePolicy",
      "Resource": "arn:aws:iam::866923470948:role/vans-*",
      "Condition": { "ArnEquals": { "iam:PolicyARN": "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole" } } },
    { "Sid": "HandRoleToLambdaOnly", "Effect": "Allow", "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::866923470948:role/vans-*",
      "Condition": { "StringEquals": { "iam:PassedToService": "lambda.amazonaws.com" } } },
    { "Sid": "VansLogs", "Effect": "Allow",
      "Action": ["logs:DescribeLogGroups", "logs:DescribeLogStreams", "logs:GetLogEvents", "logs:FilterLogEvents", "logs:PutRetentionPolicy", "logs:CreateLogGroup"],
      "Resource": "*" },
    { "Sid": "VansTables", "Effect": "Allow", "Action": "dynamodb:*",
      "Resource": [
        "arn:aws:dynamodb:ap-south-1:866923470948:table/vans-*",
        "arn:aws:dynamodb:ap-south-1:866923470948:table/vans-*/index/*"
      ] },
    { "Sid": "SeeTables", "Effect": "Allow",
      "Action": ["dynamodb:ListTables", "dynamodb:DescribeLimits"], "Resource": "*" },
    { "Sid": "VansBuckets", "Effect": "Allow", "Action": "s3:*",
      "Resource": ["arn:aws:s3:::vans-*", "arn:aws:s3:::vans-*/*"] },
    { "Sid": "SeeBuckets", "Effect": "Allow", "Action": "s3:ListAllMyBuckets", "Resource": "*" },
    { "Sid": "VansMailInMumbai", "Effect": "Allow", "Action": "ses:*", "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "ap-south-1" } } },
    { "Sid": "VansSettings", "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParameters", "ssm:GetParametersByPath", "ssm:PutParameter", "ssm:DeleteParameter", "ssm:AddTagsToResource"],
      "Resource": "arn:aws:ssm:ap-south-1:866923470948:parameter/vans/*" },
    { "Sid": "SeeSettings", "Effect": "Allow", "Action": "ssm:DescribeParameters", "Resource": "*" }
  ]
}

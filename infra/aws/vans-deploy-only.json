{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "VansFunctions", "Effect": "Allow", "Action": "lambda:*",
      "Resource": "arn:aws:lambda:ap-south-1:866923470948:function:vans-*" },
    { "Sid": "SeeFunctions", "Effect": "Allow",
      "Action": ["lambda:ListFunctions", "lambda:GetAccountSettings"], "Resource": "*" },
    { "Sid": "VansRole", "Effect": "Allow",
      "Action": ["iam:CreateRole", "iam:GetRole", "iam:DeleteRole", "iam:ListAttachedRolePolicies", "iam:DetachRolePolicy"],
      "Resource": "arn:aws:iam::866923470948:role/vans-*" },
    { "Sid": "RoleMayOnlyLog", "Effect": "Allow", "Action": "iam:AttachRolePolicy",
      "Resource": "arn:aws:iam::866923470948:role/vans-*",
      "Condition": { "ArnEquals": { "iam:PolicyARN": "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole" } } },
    { "Sid": "HandRoleToLambdaOnly", "Effect": "Allow", "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::866923470948:role/vans-*",
      "Condition": { "StringEquals": { "iam:PassedToService": "lambda.amazonaws.com" } } },
    { "Sid": "VansLogs", "Effect": "Allow",
      "Action": ["logs:DescribeLogGroups", "logs:DescribeLogStreams", "logs:GetLogEvents", "logs:FilterLogEvents", "logs:PutRetentionPolicy", "logs:CreateLogGroup"],
      "Resource": "*" }
  ]
}

{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "Tables", "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:DeleteItem", "dynamodb:Query", "dynamodb:Scan", "dynamodb:BatchGetItem", "dynamodb:BatchWriteItem"],
      "Resource": [
        "arn:aws:dynamodb:ap-south-1:866923470948:table/vans-*",
        "arn:aws:dynamodb:ap-south-1:866923470948:table/vans-*/index/*"
      ] },
    { "Sid": "Settings", "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParameters", "ssm:GetParametersByPath"],
      "Resource": "arn:aws:ssm:ap-south-1:866923470948:parameter/vans/*" },
    { "Sid": "Mail", "Effect": "Allow", "Action": ["ses:SendEmail", "ses:SendRawEmail"], "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "ap-south-1" } } },
    { "Sid": "Downloads", "Effect": "Allow", "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::vans-*/*" }
  ]
}
